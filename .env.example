# Optional: email-based password reset uses SMTP. Registration and recovery-key sign-in do not.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="GameHack <no-reply@example.com>"

# Optional in local development; set this to the deployed site URL in production.
APP_ORIGIN=http://localhost:5173

# Set a long, random value and keep it private. Required for stable production sessions.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Accounts, password hashes and recovery keys live in this one file. When
# deploying, point it at a mounted volume: the container filesystem is discarded
# on every deploy, and without a volume every credential is lost. See the
# Dockerfile, docker-compose.yml, render.yaml and fly.toml in this repo.
AUTH_DATA_FILE=.data/accounts.json
API_PORT=3001
