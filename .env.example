# SMTP account for a verified sender from your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="HACKFORGE <no-reply@example.com>"

# Optional in local development; set this to the deployed site URL in production.
APP_ORIGIN=http://localhost:5173

# Set a long, random value and keep it private. Required for stable production sessions.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Keep this directory on persistent storage when deploying.
AUTH_DATA_FILE=.data/accounts.json
API_PORT=3001
